# AI Abuse Hotline - Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Admin API authentication token (generate a secure random string)
ADMIN_TOKEN=

# =============================================================================
# OPTIONAL
# =============================================================================

# Server settings (defaults shown)
HOST=127.0.0.1
PORT=3000

# Database path (defaults to ./data/hotline.db)
DB_PATH=./data/hotline.db

# ntfy topic for push notifications (notifications disabled if unset).
# Use a long random topic name — on ntfy.sh the topic IS the access control.
NTFY_TOPIC=

# ntfy server (defaults to https://ntfy.sh; point at a self-hosted instance
# to keep notification content on your own infrastructure)
NTFY_SERVER=

# Bearer token if your ntfy server requires publish auth
NTFY_TOKEN=

# Max request body size in bytes (default: 1MB)
MAX_BODY_SIZE=1048576
